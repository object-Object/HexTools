  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./src/index.ts",
  "scripts": {
    "prepack": "vite build"
  },
  "dependencies": {
    "bytebuffer": "^5.0.1",
    "gl-matrix": "^4.0.0-beta.2",
    "simplex-noise": "^4.0.3"
  },
  "devDependencies": {
    "@types/bytebuffer": "^5.0.49",
    "vite": "^8.0.0-beta.13"
