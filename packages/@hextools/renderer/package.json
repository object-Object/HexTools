{
  "name": "@hextools/renderer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    },
    "./shaders": {
      "types": "./src/shaders/index.ts",
      "require": "./dist/shaders.cjs",
      "import": "./dist/shaders.js"
    },
    "./staffGrid": {
      "types": "./src/staffGrid/index.ts",
      "require": "./dist/staffGrid.cjs",
      "import": "./dist/staffGrid.js"
    }
